<?xml version="1.0"?>
<labwc>
   <!-- -----------------------------
        DEFAULT LIGHT / NORMAL PROFILE
        ----------------------------- -->
   <profile name="default">
       <background>
           <path>/var/www/html/files/background.jpg</path>
           <mode>stretch</mode>
       </background>

       <!-- Optional: normal UI colors -->
       <colors>
           <active_border>#888888</active_border>
           <inactive_border>#444444</inactive_border>
       </colors>
   </profile>


   <!-- -----------------------------
        DARK-MODE / NIGHT PROFILE
        Ultra-dark wallpaper + red tones
        ----------------------------- -->
   <profile name="dark">
       <background>
           <path>/var/www/html/files/background.jpg</path>
           <mode>stretch</mode>
       </background>

       <!--  
           Colors chosen to protect dark adaptation:
           - Very dim red accents
           - Almost-black interface
       -->
       <colors>
           <active_border>#220000</active_border>      <!-- dark red -->
           <inactive_border>#110000</inactive_border>  <!-- even darker red -->
           <menu_bg>#050000</menu_bg>                  <!-- near black -->
           <menu_fg>#ff4444</menu_fg>                  <!-- dim red text -->
           <panel_bg>#080000</panel_bg>
           <panel_fg>#ff3333</panel_fg>
           <titlebar_bg>#0a0000</titlebar_bg>
           <titlebar_fg>#ff4444</titlebar_fg>
       </colors>

       <!-- Optional: dim window shadows for night mode -->
       <shadow>
           <size>10</size>
           <color>#330000</color>
       </shadow>
   </profile>


   <!-- --------------------------------------------
        SET WHICH PROFILE IS ACTIVE ON LOGIN
        Change "default" → "dark" to enable night mode
        -------------------------------------------- -->
   <active_profile>default</active_profile>

</labwc>