[connection]
id=TahtiOShotSpot
type=wifi
autoconnect=yes
autoconnect-priority=-999
interface-name=wlan0
permissions=

[wifi]
mode=ap
ssid=TahtiOSwifi
band=bg
channel=6


[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
psk=SomePasssword123

[ipv4]
method=shared

[ipv6]
method=ignore